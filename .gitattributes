# Default to LF for text files; let editors do the right thing on Windows.
* text=auto eol=lf

# Windows-script-only files keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.wav binary
*.mp3 binary
*.ogg binary
*.flac binary
*.onnx binary
*.exe binary
*.dll binary
*.msi binary
*.pdb binary
